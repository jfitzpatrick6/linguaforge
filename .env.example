# LinguaForge example environment file
# Copy to .env and adjust for your local setup.

# OpenAI-compatible local LLM server (vLLM, llama.cpp, Ollama, etc.)
AI_BASE_URL=http://localhost:8000/v1
AI_MODEL=qwen3-coder-30b-a3b

# Local SQLite database
DB_PATH=./data/linguaforge.db

# Persistent Chroma vector store (used by PDF grounding later)
CHROMA_PATH=./data/chroma
